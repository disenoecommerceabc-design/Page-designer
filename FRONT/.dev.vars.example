# Copia como .dev.vars para desarrollo local. No publiques ese archivo.
KIE_API_KEY="PEGA_TU_CLAVE_KIE"
AI_ENABLED="false"
# Habilitar invitados permite consumir tu saldo desde sesiones de navegador.
# Mantén false para un servicio público hasta disponer de autenticación y planes.
AI_ALLOW_GUESTS="false"
KIE_TEXT_MODEL="gpt-6-luna"
KIE_DESIGN_MODEL="gpt-6-1-terra"
KIE_IMAGE_VARIANT="flare"
KIE_IMAGE_RESOLUTION="1K"
AI_USER_DAILY_CREDITS="30"
AI_GLOBAL_DAILY_CREDITS="100"
AI_DAILY_REQUESTS="20"
AI_COOLDOWN_SECONDS="5"
KIE_ASSET_HOSTS="file.aiquickdraw.com,static.aiquickdraw.com,tempfile.redpandaai.co"
