# Sin clave, el editor manual funciona y la IA permanece deshabilitada.
KIE_API_KEY=
AI_ENABLED=false
APP_ENV=local
# Obligatorios para APP_ENV=production. HTTPS y COOKIE_SECURE=true en la nube.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Opcional: habilita cuentas de clientes con cupos y proyectos independientes.
REGISTRATION_CODE=
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATA_DIR=./data
AI_DAILY_CREDITS=30
AI_GLOBAL_DAILY_CREDITS=60
AI_DAILY_REQUESTS=15
AI_TEXT_CREDITS=1
AI_IMAGE_CREDITS=5
AI_DESIGN_CREDITS=3
AI_COOLDOWN_SECONDS=5
# Créditos INTERNOS del producto, no dólares ni créditos facturados por Kie.
# Revisar tarifas en Kie y fijar límites de gasto también en la cuenta del proveedor.
KIE_TEXT_MODEL=gpt-6-luna
KIE_DESIGN_MODEL=gpt-6.1-terra
KIE_IMAGE_DIRECTOR_MODEL=gpt-6-luna
AI_DIRECTOR_MAX_OUTPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=1200
